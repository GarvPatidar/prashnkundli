generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  FORGOT_PASSWORD
  PHONE_CHANGE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TradingStyle {
  SCALPING
  INTRADAY
  SWING
}

enum RiskTolerance {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                String         @id @default(cuid())
  email             String?        @unique
  phone             String         @unique
  countryCode       String         @default("+91")
  fullName          String?
  passwordHash      String?
  status            UserStatus     @default(PENDING_VERIFICATION)
  phoneVerifiedAt   DateTime?
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  whatsappConsent   Boolean        @default(false)

  profile           TraderProfile?
  sessions          UserSession[]
  otpCodes          OtpCode[]
  conversations     Conversation[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

model TraderProfile {
  id                  String          @id @default(cuid())
  userId              String          @unique
  experienceLevel     ExperienceLevel?
  tradingStyle        TradingStyle?
  accountSize         String?
  mainChallenge       String?
  preferredTimeframe  String?
  riskTolerance       RiskTolerance?
  timezone            String?
  country             String?
  onboardingCompleted Boolean         @default(false)

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model UserSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model OtpCode {
  id          String     @id @default(cuid())
  userId      String?
  phone       String
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())

  @@index([phone, purpose, expiresAt])
  @@index([userId])
}

model Conversation {
  id        String           @id @default(cuid())
  userId    String?
  title     String
  symbol    String           @default("XAUUSD")
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  Message[]
  snapshots MarketSnapshot[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, updatedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  role           MessageRole
  status         MessageStatus @default(COMPLETED)
  content        String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
}

model MarketSnapshot {
  id             String       @id @default(cuid())
  conversationId String
  symbol         String
  quote          Json
  session        Json
  candles        Json
  indicators     Json
  levels         Json
  calendar       Json
  provider       String
  capturedAt     DateTime
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, capturedAt])
}