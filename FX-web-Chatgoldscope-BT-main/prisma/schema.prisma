generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  FORGOT_PASSWORD
  PHONE_CHANGE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TradingStyle {
  SCALPING
  INTRADAY
  SWING
}

enum RiskTolerance {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                String         @id @default(cuid())
  email             String?        @unique
  phone             String         @unique
  countryCode       String         @default("+91")
  fullName          String?
  passwordHash      String?
  status            UserStatus     @default(PENDING_VERIFICATION)
  phoneVerifiedAt   DateTime?
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  whatsappConsent   Boolean        @default(false)

  profile           TraderProfile?
  sessions          UserSession[]
  otpCodes          OtpCode[]
  conversations     Conversation[]
  feedback          MessageFeedback[]
  journalTrades     JournalTrade[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

model TraderProfile {
  id                  String          @id @default(cuid())
  userId              String          @unique
  experienceLevel     ExperienceLevel?
  tradingStyle        TradingStyle?
  accountSize         String?
  mainChallenge       String?
  preferredTimeframe  String?
  riskTolerance       RiskTolerance?
  timezone            String?
  country             String?
  onboardingCompleted Boolean         @default(false)

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model UserSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model OtpCode {
  id          String     @id @default(cuid())
  userId      String?
  phone       String
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())

  @@index([phone, purpose, expiresAt])
  @@index([userId])
}

model Conversation {
  id        String           @id @default(cuid())
  userId    String?
  title     String
  symbol    String           @default("XAUUSD")
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  Message[]
  snapshots MarketSnapshot[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, updatedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  role           MessageRole
  status         MessageStatus @default(COMPLETED)
  content        String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback       MessageFeedback[]
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
}

model MarketSnapshot {
  id             String       @id @default(cuid())
  conversationId String
  symbol         String
  quote          Json
  session        Json
  candles        Json
  indicators     Json
  levels         Json
  calendar       Json
  provider       String
  capturedAt     DateTime
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, capturedAt])
}

enum SignalDirection {
  BUY
  SELL
}

enum SignalStatus {
  PENDING
  ACTIVE
  TP1_HIT
  STOPPED
  EXPIRED
  TIMEOUT
}

enum FeedbackRating {
  UP
  DOWN
}

enum JournalStatus {
  OPEN
  CLOSED
}

/// Every actionable BUY/SELL plan the bot issued. Outcomes are filled in
/// automatically from market candles, so the track record needs no user input.
model Signal {
  id           String          @id @default(cuid())
  symbol       String          @default("XAUUSD")
  horizon      String
  direction    SignalDirection
  conviction   String
  entryState   String
  priceAtIssue Float
  entry        Float
  stopLoss     Float
  tp1          Float
  tp2          Float?
  riskReward1  Float
  /// Last moment the entry level can still be touched.
  expiresAt    DateTime
  /// Last moment an open trade is followed before being closed at market.
  maxHoldUntil DateTime
  status       SignalStatus    @default(PENDING)
  triggeredAt  DateTime?
  closedAt     DateTime?
  exitPrice    Float?
  /// Result in R multiples: TP1 = +reward:risk, stop = -1.
  resultR      Float?
  tp2Hit       Boolean         @default(false)
  dedupeKey    String          @unique

  journalTrades JournalTrade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model MessageFeedback {
  id        String         @id @default(cuid())
  messageId String
  userId    String
  rating    FeedbackRating
  reason    String?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([userId])
}

/// A trade the user reports taking. Entered by the user, because the bot
/// cannot know whether a signal was actually traded.
model JournalTrade {
  id         String          @id @default(cuid())
  userId     String
  signalId   String?
  direction  SignalDirection
  entry      Float
  stopLoss   Float?
  takeProfit Float?
  lots       Float?
  status     JournalStatus   @default(OPEN)
  exitPrice  Float?
  /// Points gained or lost, signed for the trade direction.
  pnlPoints  Float?
  note       String?
  openedAt   DateTime        @default(now())
  closedAt   DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal Signal? @relation(fields: [signalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, openedAt])
}
