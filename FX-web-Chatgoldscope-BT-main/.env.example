NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Authentication Secrets (Must be at least 32 characters long in production)
JWT_ACCESS_SECRET=your_32_characters_minimum_super_secret_access_key_here
JWT_REFRESH_SECRET=your_32_characters_minimum_super_secret_refresh_key_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Frontend Connection & CORS
FRONTEND_ORIGIN=https://your-frontend.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
TRUST_PROXY=true

# AI Provider ("mock" or "openai")
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Market Provider ("mock" or "twelve-data")
MARKET_PROVIDER=mock
TWELVE_DATA_API_KEY=
TWELVE_DATA_CREDITS_PER_MINUTE=7

# Economic Calendar & News ("mock" or "trading-economics")
CALENDAR_PROVIDER=mock
NEWS_PROVIDER=mock
TRADING_ECONOMICS_API_KEY=

# Storage ("local" or "r2")
STORAGE_PROVIDER=local

# OTP Provider ("mock" or "whatsapp")
OTP_PROVIDER=mock
AUTO_ACTIVATE_USERS=true
